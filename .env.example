# 这个文件是可选的：不建 .env 也完全能用 —— 启动后在页面右上角的「设置」里
# 填 API Key，它会存进服务端的 data/config.json，重启也还在，并且优先级高于这里。
# .env 适合想用环境变量做初始配置的部署（比如 Docker）。复制成 .env 后填写。
# 两套 provider 任选其一，也可以都填、用 LLM_PROVIDER 切换。

# claude | openai | auto（默认 auto：填了 OPENAI_BASE_URL 就走 openai，否则走 claude）
LLM_PROVIDER=auto

# --- Anthropic 官方 ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# 思考深度：low / medium / high / xhigh / max，留空或填错都回落到 medium
#（app/config.py 的 DEFAULT_EFFORT，故意比 Anthropic 自己的默认 high 低一档，快得多）。
# 这是最直接的快慢开关：嫌慢就调 low。仅对 Claude 生效，网关那条路没有这个参数。
# 页面右上角设置里也能改，且优先级高于这里。
ANTHROPIC_EFFORT=

# --- OpenAI 兼容网关（中转、自建、Qwen-VL、GPT-4o 等）---
# base_url 填到 /v1 为止，不要带 /chat/completions
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Mapbox 地图 ---
# 结果页用它把判定位置直接画在地图上。留空则退回内置的正射投影示意图。
# 这只是初始值：页面「设置 → 地图」里填的令牌存在服务端 data/config.json，
# 会覆盖这里，换令牌不需要改这个文件、也不需要重启后端。
# 必须填公开令牌（pk. 开头）并在 Mapbox 后台按域名做 URL 限制 —— 它会下发到浏览器。
# 千万不要填 sk. 开头的私密令牌。
MAPBOX_TOKEN=

# --- 服务参数 ---
MAX_UPLOAD_MB=12
MAX_IMAGE_EDGE=2000
REQUESTS_PER_HOUR=40
# 只有来自这些地址的请求，其 X-Forwarded-For 才会被当真（逗号分隔，留空＝谁都不信）。
# 这个头谁都能伪造，无条件相信它等于取消限流。
# 注意还要给 uvicorn 加 --no-proxy-headers：它默认会先一步用 XFF 改写来源地址。
TRUSTED_PROXIES=
REQUEST_TIMEOUT_SECONDS=240
# 被安全策略拒答时，让 Anthropic 自动改用备选模型重跑（仅 Claude 生效）
REFUSAL_FALLBACK=true
