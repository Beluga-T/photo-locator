.env

# ...and the copies people make of it. An editor's .env.save, a hurried
# .env.bak before trying something, .env.local from a habit picked up
# elsewhere: each one holds the same API key as .env, and none of them is
# covered by the line above. .env.example is the one that must stay tracked --
# it is the documentation.
.env.*
!.env.example

# Everything the running app writes about itself: the credentials entered in
# the settings sheet and every photo that has been analysed. Committing this
# would publish an API key and someone's pictures.
data/

# Built by run.py, along with the .requirements-stamp it keeps inside.
# Disposable: `python run.py --recreate-venv` makes it again.
.venv/
venv/

# PyInstaller output from a local `python -m PyInstaller photo-locator.spec`.
# dist/ holds a ~17 MB binary — one careless `git add -A` after a local build
# would bake it into a public repo's history permanently. photo-locator.spec
# itself is source and stays tracked.
build/
dist/
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
